# Copy to .env and change the secrets before running:  cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set to True when serving over HTTPS
DJANGO_SECURE_COOKIES=False
TIME_ZONE=Asia/Kolkata

# Key that encrypts stored mail passwords. Generate one with:
#   docker compose run --rm web python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty a key derived from DJANGO_SECRET_KEY is used (then never change the secret key).
FIELD_ENCRYPTION_KEY=

# First administrator, created on start if no user has this email yet.
# Everyone signs in with their EMAIL ADDRESS and password.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

# --- PostgreSQL ---
POSTGRES_DB=mailbox
POSTGRES_USER=mailbox
POSTGRES_PASSWORD=mailbox-db-password

# --- Mailbox ---
MAILBOX_PORT=8000
MAILBOX_ALLOW_SIGNUP=True
MAILBOX_SYNC_INTERVAL=60
MAILBOX_INITIAL_SYNC_LIMIT=500
MAILBOX_PAGE_SIZE=50
MAILBOX_MAX_ATTACHMENT_MB=25
GUNICORN_WORKERS=3

# --- Admin panel: create Linux users on the Ubuntu server ---
# Full setup steps are on the "Ubuntu server" page of the admin panel and in tools/server/README.md.
LINUX_USERS_ENABLED=False
LINUX_SSH_HOST=
LINUX_SSH_PORT=22
LINUX_SSH_USER=mailboxadm
# Private key (put it in ./ssh/ next to docker-compose.yml) or a password
LINUX_SSH_KEY_FILE=/app/ssh/id_ed25519
LINUX_SSH_PASSWORD=
# Server identity: run `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub` on the server
LINUX_SSH_HOST_FINGERPRINT=
LINUX_DEFAULT_SHELL=/usr/sbin/nologin
LINUX_DEFAULT_GROUPS=
